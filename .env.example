# GEMINI_API_KEY: Required for Gemini AI API calls (profile bio writing, translation, moderation).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://lovemeetly.com"

# Database Configuration (Neon PostgreSQL Cloud Database)
DATABASE_URL=""

# Authentication & Session Security
JWT_SECRET=""
SESSION_SECRET=""

# Payments (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# S3-Compatible Object Storage (Cloudflare R2 / AWS S3 / Supabase Storage)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# External Partner Providers Integration
EXTERNAL_PROVIDER_API_KEY=""

# SMTP Mail Configuration (Password Recovery & Notifications)
SMTP_HOST="smtp-prod.mailrcld.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lovemeetly Support <support@lovemeetly.com>"

# NOWPayments Crypto Payment Gateway Configuration
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_SANDBOX=false

# Firebase Admin SDK (Web FCM push) — server-side only.
# Path to the Firebase service-account JSON stored OUTSIDE the repo and outside
# any public web directory, e.g. /home/<cpanel-user>/firebase-private/sa.json.
# Never commit the JSON or paste its contents into source/config.
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Optional: inline service-account JSON (server-side env only, never committed).
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Firebase Web Push VAPID public key for project `app-lovemeetly` (client-safe,
# NOT a secret). Exposed to the web build via Vite; falls back to the built-in
# public key when unset.
# VITE_FIREBASE_VAPID_KEY="BPtxb_OMFRpUWDuZn_xTeZWrjv2sCJHjcW0WYV-VGMil81sSXIc5Ss5BTX5iSUsdFVP9FFv5qbNLvNarNrg3AVQ"

