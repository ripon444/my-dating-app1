<?xml version="1.0" encoding="utf-8"?>
<!--
  Native incoming-call screen used while the app is closed/backgrounded (full-screen intent).
  Kept deliberately simple: it only offers Answer/Decline, which hand the call over to the
  existing web call flow.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0c0a09"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingTop="72dp"
        android:paddingRight="28dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lovemeetly_call_ongoing_label"
            android:textAllCaps="true"
            android:textColor="#f5f5f4"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lovemeetly_call_caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/lovemeetly_call_default_caller"
            android:textColor="#ffffff"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lovemeetly_call_caller_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/lovemeetly_call_voice_label"
            android:textColor="#e7a1b7"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lovemeetly_call_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#a8a29e"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/lovemeetly_call_decline_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#e11d48"
                android:text="@string/lovemeetly_call_decline"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/lovemeetly_call_answer_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="@string/lovemeetly_call_answer"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/lovemeetly_call_native_notice"
            android:textColor="#78716c"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>