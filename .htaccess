# Apache / LiteSpeed Configuration for Lovemeetly
DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve compiled production HTML for root and index.html
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # Direct pass-through for backend API endpoints and socket.io
  RewriteRule ^(server-api|api|socket\.io)(/.*)?$ - [L]

  # If requested path exists directly inside dist/ (e.g. /assets/...), rewrite to dist/
  RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Security: Deny access to sensitive files and directories
  RewriteRule ^(\.env|\.git|data/|server/|src/|package\.json|bun\.lock|tsconfig.*) - [F,L]
</IfModule>
